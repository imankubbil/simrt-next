generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

model User {
  id           String       @id @default(cuid())
  nik          String       @unique
  password     String
  namaLengkap  String
  jenisKelamin JenisKelamin @default(L)
  tempatLahir  String?
  tanggalLahir DateTime?
  agama        Agama        @default(ISLAM)
  role         Role         @default(WARGA)
  wilayahRwId  String?
  wilayahRtId  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  warga          Warga?
  penugasanRw    WilayahRw?        @relation("PenugasanRw", fields: [wilayahRwId], references: [id], onDelete: SetNull)
  penugasanRt    WilayahRt?        @relation("PenugasanRt", fields: [wilayahRtId], references: [id], onDelete: SetNull)
  ketuaRwUntuk   WilayahRw[]       @relation("KetuaRw")
  ketuaRtUntuk   WilayahRt[]       @relation("KetuaRt")
  suratDibuat    Surat[]           @relation("SuratDibuatOleh")
  iuranDicatat   PembayaranIuran[] @relation("IuranDicatatOleh")
  mutasiDicatat  MutasiPenduduk[]  @relation("MutasiDicatatOleh")
  kegiatanDibuat Kegiatan[]        @relation("KegiatanDibuatOleh")

  @@index([wilayahRwId])
  @@index([wilayahRtId])
}

enum Role {
  ADMIN
  PENGURUS_RW
  PENGURUS_RT
  WARGA
}

enum JenisKelamin {
  L
  P
}

enum Agama {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDHA
  KONGHUCU
}

// ==================== KEPENDUDUKAN ====================

model Warga {
  id                 String          @id @default(cuid())
  user               User            @relation(fields: [userId], references: [id])
  userId             String          @unique
  jenisPekerjaan     JenisPekerjaan? @relation(fields: [jenisPekerjaanId], references: [id])
  jenisPekerjaanId   String?
  kewarganegaraan    Kewarganegaraan @default(WNI)
  namaAyah           String?
  namaIbu            String?
  alamat             String?
  statusAktif        Boolean         @default(true)
  kategoriTidakAktif String?
  keterangan         String?
  wilayahRtId        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  wilayahRt       WilayahRt?        @relation(fields: [wilayahRtId], references: [id], onDelete: Restrict)
  anggotaKK       AnggotaKeluarga?
  wargaSementara  WargaSementara?
  suratList       Surat[]
  pembayaranIuran PembayaranIuran[]
  mutasi          MutasiPenduduk[]
  nomorIdentitas  NomorIdentitas[]

  @@index([wilayahRtId])
}

enum Kewarganegaraan {
  WNI
  WNA
}

model WargaSementara {
  id            String    @id @default(cuid())
  warga         Warga     @relation(fields: [wargaId], references: [id])
  wargaId       String    @unique
  asalDaerah    String
  asalAlamat    String
  tanggalDatang DateTime
  tanggalKeluar DateTime?
  createdAt     DateTime  @default(now())
}

model JenisPekerjaan {
  id         String  @id @default(cuid())
  nama       String  @unique
  keterangan String?
  wargaList  Warga[]
}

model JenisIdentitas {
  id         String           @id @default(cuid())
  nama       String           @unique
  keterangan String?
  nomorList  NomorIdentitas[]
}

model NomorIdentitas {
  id               String         @id @default(cuid())
  warga            Warga          @relation(fields: [wargaId], references: [id])
  wargaId          String
  jenisIdentitas   JenisIdentitas @relation(fields: [jenisIdentitasId], references: [id])
  jenisIdentitasId String
  nomorIdentitas   String

  @@unique([wargaId, jenisIdentitasId])
}

// ==================== KARTU KELUARGA ====================

model KartuKeluarga {
  id          String   @id @default(cuid())
  nomorKK     String   @unique
  alamat      String
  rt          String?
  rw          String?
  wilayahRtId String?
  kodePos     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wilayahRt WilayahRt?        @relation(fields: [wilayahRtId], references: [id], onDelete: Restrict)
  anggota   AnggotaKeluarga[]
  mutasi    MutasiPenduduk[]

  @@index([wilayahRtId])
}

model AnggotaKeluarga {
  id              String           @id @default(cuid())
  kartuKeluarga   KartuKeluarga    @relation(fields: [kartuKeluargaId], references: [id])
  kartuKeluargaId String
  warga           Warga            @relation(fields: [wargaId], references: [id])
  wargaId         String           @unique
  hubungan        HubunganKeluarga
  tanggalMasuk    DateTime         @default(now())

  @@unique([kartuKeluargaId, wargaId])
}

enum HubunganKeluarga {
  KEPALA_KELUARGA
  ISTRI
  ANAK
  MENANTU
  CUCU
  ORANG_TUA
  MERTUA
  FAMILI_LAIN
  LAINNYA
}

// ==================== SURAT ====================

model JenisSurat {
  id           String  @id @default(cuid())
  nama         String
  kodePrefix   String  @unique
  templateHtml String  @db.Text
  aktif        Boolean @default(true)
  counter      Int     @default(0)
  counterTahun Int     @default(2026)
  suratList    Surat[]
}

model Surat {
  id              String      @id @default(cuid())
  nomorSurat      String      @unique
  jenisSurat      JenisSurat  @relation(fields: [jenisSuratId], references: [id])
  jenisSuratId    String
  warga           Warga       @relation(fields: [wargaId], references: [id])
  wargaId         String
  wilayahRtId     String?
  keperluan       String      @db.Text
  tanggal         DateTime
  dataTambahan    Json?
  status          StatusSurat @default(DRAFT)
  catatanAdmin    String?
  tanggalDiajukan DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       User        @relation("SuratDibuatOleh", fields: [createdById], references: [id])
  createdById     String
  wilayahRt       WilayahRt?  @relation(fields: [wilayahRtId], references: [id], onDelete: Restrict)

  @@index([wilayahRtId])
}

enum StatusSurat {
  DRAFT
  DIAJUKAN
  DISETUJUI
  DITOLAK
  SELESAI
}

// ==================== KEUANGAN ====================

model JenisIuran {
  id         String            @id @default(cuid())
  nama       String
  nominal    Decimal           @db.Decimal(12, 0)
  periode    PeriodeIuran      @default(BULANAN)
  aktif      Boolean           @default(true)
  keterangan String?
  pembayaran PembayaranIuran[]
}

enum PeriodeIuran {
  BULANAN
  TAHUNAN
}

model PembayaranIuran {
  id           String     @id @default(cuid())
  warga        Warga      @relation(fields: [wargaId], references: [id])
  wargaId      String
  jenisIuran   JenisIuran @relation(fields: [jenisIuranId], references: [id])
  jenisIuranId String
  bulan        Int
  tahun        Int
  nominalBayar Decimal    @db.Decimal(12, 0)
  tanggalBayar DateTime
  keterangan   String?
  createdAt    DateTime   @default(now())
  createdBy    User       @relation("IuranDicatatOleh", fields: [createdById], references: [id])
  createdById  String
  wilayahRtId  String?
  wilayahRt    WilayahRt? @relation(fields: [wilayahRtId], references: [id], onDelete: Restrict)

  @@unique([wargaId, jenisIuranId, bulan, tahun])
  @@index([wilayahRtId])
}

// ==================== MUTASI ====================

model MutasiPenduduk {
  id                String         @id @default(cuid())
  warga             Warga          @relation(fields: [wargaId], references: [id])
  wargaId           String
  jenisMutasi       JenisMutasi
  tanggal           DateTime
  keterangan        String?
  alamatTujuan      String?
  alamatAsal        String?
  tempatMeninggal   String?
  penyebab          String?
  kartuKeluarga     KartuKeluarga? @relation(fields: [kartuKeluargaId], references: [id])
  kartuKeluargaId   String?
  createdAt         DateTime       @default(now())
  createdBy         User           @relation("MutasiDicatatOleh", fields: [createdById], references: [id])
  createdById       String
  wilayahRtId       String?
  wilayahRt         WilayahRt?     @relation(fields: [wilayahRtId], references: [id], onDelete: Restrict)
  wilayahRtTujuanId String?
  wilayahRtTujuan   WilayahRt?     @relation("MutasiTujuan", fields: [wilayahRtTujuanId], references: [id], onDelete: Restrict)

  @@index([wilayahRtId])
  @@index([wilayahRtTujuanId])
}

enum JenisMutasi {
  LAHIR
  MENINGGAL
  PINDAH_MASUK
  PINDAH_KELUAR
}

// ==================== KEGIATAN ====================

model JenisKegiatan {
  id       String     @id @default(cuid())
  nama     String     @unique
  warna    String     @default("#3498db")
  kegiatan Kegiatan[]
}

model Kegiatan {
  id             String        @id @default(cuid())
  judul          String
  jenis          JenisKegiatan @relation(fields: [jenisId], references: [id])
  jenisId        String
  deskripsi      String?
  tanggalMulai   DateTime
  tanggalSelesai DateTime?
  lokasi         String?
  berulang       Berulang      @default(TIDAK)
  catatanHasil   String?       @db.Text
  createdAt      DateTime      @default(now())
  createdBy      User          @relation("KegiatanDibuatOleh", fields: [createdById], references: [id])
  createdById    String
  wilayahRtId    String?
  wilayahRt      WilayahRt?    @relation(fields: [wilayahRtId], references: [id], onDelete: Restrict)

  @@index([wilayahRtId])
}

enum Berulang {
  TIDAK
  MINGGUAN
  BULANAN
}

// ==================== INVENTARIS ====================

model KategoriAset {
  id   String @id @default(cuid())
  nama String @unique
  aset Aset[]
}

model Aset {
  id                String       @id @default(cuid())
  kode              String       @unique
  nama              String
  kategori          KategoriAset @relation(fields: [kategoriId], references: [id])
  kategoriId        String
  jumlah            Int          @default(1)
  kondisi           KondisiAset  @default(BAIK)
  tanggalPerolehan  DateTime?
  nilaiPerolehan    Decimal?     @db.Decimal(12, 0)
  lokasiPenyimpanan String?
  keterangan        String?
  fotoUrl           String?
  createdAt         DateTime     @default(now())
  wilayahRtId       String?
  wilayahRt         WilayahRt?   @relation(fields: [wilayahRtId], references: [id], onDelete: Restrict)

  @@index([wilayahRtId])
}

enum KondisiAset {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
}

// ==================== KONFIGURASI ====================

model WilayahRw {
  id         String   @id @default(cuid())
  nomor      String   @unique
  ketuaRwId  String?
  ttdKetuaRw String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ketuaRw  User?       @relation("KetuaRw", fields: [ketuaRwId], references: [id], onDelete: SetNull)
  pengurus User[]      @relation("PenugasanRw")
  rtList   WilayahRt[]
}

model WilayahRt {
  id         String   @id @default(cuid())
  nomor      String
  rwId       String
  ketuaRtId  String?
  ttdKetuaRt String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rw                  WilayahRw         @relation(fields: [rwId], references: [id], onDelete: Restrict)
  ketuaRt             User?             @relation("KetuaRt", fields: [ketuaRtId], references: [id], onDelete: SetNull)
  pengurus            User[]            @relation("PenugasanRt")
  wargaList           Warga[]
  kkList              KartuKeluarga[]
  suratList           Surat[]
  pembayaranIuranList PembayaranIuran[]
  mutasiList          MutasiPenduduk[]
  mutasiTujuanList    MutasiPenduduk[]  @relation("MutasiTujuan")
  kegiatanList        Kegiatan[]
  asetList            Aset[]

  @@unique([rwId, nomor])
}

model KonfigurasiSistem {
  id         String  @id @default("singleton")
  kabupaten  String?
  kecamatan  String?
  desa       String?
  dusun      String?
  kodePos    String?
  rt         String?
  rw         String?
  ketuaRtId  String?
  ketuaRwId  String?
  ttdKetuaRt String? @db.Text
  ttdKetuaRw String? @db.Text
}
