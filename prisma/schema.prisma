generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

model User {
  id           String       @id @default(cuid())
  nik          String       @unique
  password     String
  namaLengkap  String
  jenisKelamin JenisKelamin @default(L)
  tempatLahir  String?
  tanggalLahir DateTime?
  agama        Agama        @default(ISLAM)
  role         Role         @default(WARGA)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  warga          Warga?
  suratDibuat    Surat[]           @relation("SuratDibuatOleh")
  iuranDicatat   PembayaranIuran[] @relation("IuranDicatatOleh")
  mutasiDicatat  MutasiPenduduk[]  @relation("MutasiDicatatOleh")
  kegiatanDibuat Kegiatan[]        @relation("KegiatanDibuatOleh")
}

enum Role {
  ADMIN
  WARGA
}

enum JenisKelamin {
  L
  P
}

enum Agama {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDHA
  KONGHUCU
}

// ==================== KEPENDUDUKAN ====================

model Warga {
  id                 String          @id @default(cuid())
  user               User            @relation(fields: [userId], references: [id])
  userId             String          @unique
  jenisPekerjaan     JenisPekerjaan? @relation(fields: [jenisPekerjaanId], references: [id])
  jenisPekerjaanId   String?
  kewarganegaraan    Kewarganegaraan @default(WNI)
  namaAyah           String?
  namaIbu            String?
  alamat             String?
  statusAktif        Boolean         @default(true)
  kategoriTidakAktif String?
  keterangan         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  anggotaKK       AnggotaKeluarga?
  wargaSementara  WargaSementara?
  suratList       Surat[]
  pembayaranIuran PembayaranIuran[]
  mutasi          MutasiPenduduk[]
  nomorIdentitas  NomorIdentitas[]
}

enum Kewarganegaraan {
  WNI
  WNA
}

model WargaSementara {
  id            String    @id @default(cuid())
  warga         Warga     @relation(fields: [wargaId], references: [id])
  wargaId       String    @unique
  asalDaerah    String
  asalAlamat    String
  tanggalDatang DateTime
  tanggalKeluar DateTime?
  createdAt     DateTime  @default(now())
}

model JenisPekerjaan {
  id         String  @id @default(cuid())
  nama       String  @unique
  keterangan String?
  wargaList  Warga[]
}

model JenisIdentitas {
  id         String           @id @default(cuid())
  nama       String           @unique
  keterangan String?
  nomorList  NomorIdentitas[]
}

model NomorIdentitas {
  id               String         @id @default(cuid())
  warga            Warga          @relation(fields: [wargaId], references: [id])
  wargaId          String
  jenisIdentitas   JenisIdentitas @relation(fields: [jenisIdentitasId], references: [id])
  jenisIdentitasId String
  nomorIdentitas   String

  @@unique([wargaId, jenisIdentitasId])
}

// ==================== KARTU KELUARGA ====================

model KartuKeluarga {
  id        String   @id @default(cuid())
  nomorKK   String   @unique
  alamat    String
  rt        String?
  rw        String?
  kodePos   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anggota AnggotaKeluarga[]
  mutasi  MutasiPenduduk[]
}

model AnggotaKeluarga {
  id              String           @id @default(cuid())
  kartuKeluarga   KartuKeluarga    @relation(fields: [kartuKeluargaId], references: [id])
  kartuKeluargaId String
  warga           Warga            @relation(fields: [wargaId], references: [id])
  wargaId         String           @unique
  hubungan        HubunganKeluarga
  tanggalMasuk    DateTime         @default(now())

  @@unique([kartuKeluargaId, wargaId])
}

enum HubunganKeluarga {
  KEPALA_KELUARGA
  ISTRI
  ANAK
  MENANTU
  CUCU
  ORANG_TUA
  MERTUA
  FAMILI_LAIN
  LAINNYA
}

// ==================== SURAT ====================

model JenisSurat {
  id           String  @id @default(cuid())
  nama         String
  kodePrefix   String  @unique
  templateHtml String  @db.Text
  aktif        Boolean @default(true)
  counter      Int     @default(0)
  counterTahun Int     @default(2026)
  suratList    Surat[]
}

model Surat {
  id              String      @id @default(cuid())
  nomorSurat      String      @unique
  jenisSurat      JenisSurat  @relation(fields: [jenisSuratId], references: [id])
  jenisSuratId    String
  warga           Warga       @relation(fields: [wargaId], references: [id])
  wargaId         String
  keperluan       String      @db.Text
  tanggal         DateTime
  dataTambahan    Json?
  status          StatusSurat @default(DRAFT)
  catatanAdmin    String?
  tanggalDiajukan DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       User        @relation("SuratDibuatOleh", fields: [createdById], references: [id])
  createdById     String
}

enum StatusSurat {
  DRAFT
  DIAJUKAN
  DISETUJUI
  DITOLAK
  SELESAI
}

// ==================== KEUANGAN ====================

model JenisIuran {
  id         String       @id @default(cuid())
  nama       String
  nominal    Decimal      @db.Decimal(12, 0)
  periode    PeriodeIuran @default(BULANAN)
  aktif      Boolean      @default(true)
  keterangan String?
  pembayaran PembayaranIuran[]
}

enum PeriodeIuran {
  BULANAN
  TAHUNAN
}

model PembayaranIuran {
  id           String     @id @default(cuid())
  warga        Warga      @relation(fields: [wargaId], references: [id])
  wargaId      String
  jenisIuran   JenisIuran @relation(fields: [jenisIuranId], references: [id])
  jenisIuranId String
  bulan        Int
  tahun        Int
  nominalBayar Decimal    @db.Decimal(12, 0)
  tanggalBayar DateTime
  keterangan   String?
  createdAt    DateTime   @default(now())
  createdBy    User       @relation("IuranDicatatOleh", fields: [createdById], references: [id])
  createdById  String

  @@unique([wargaId, jenisIuranId, bulan, tahun])
}

// ==================== MUTASI ====================

model MutasiPenduduk {
  id              String         @id @default(cuid())
  warga           Warga          @relation(fields: [wargaId], references: [id])
  wargaId         String
  jenisMutasi     JenisMutasi
  tanggal         DateTime
  keterangan      String?
  alamatTujuan    String?
  alamatAsal      String?
  tempatMeninggal String?
  penyebab        String?
  kartuKeluarga   KartuKeluarga? @relation(fields: [kartuKeluargaId], references: [id])
  kartuKeluargaId String?
  createdAt       DateTime       @default(now())
  createdBy       User           @relation("MutasiDicatatOleh", fields: [createdById], references: [id])
  createdById     String
}

enum JenisMutasi {
  LAHIR
  MENINGGAL
  PINDAH_MASUK
  PINDAH_KELUAR
}

// ==================== KEGIATAN ====================

model JenisKegiatan {
  id       String     @id @default(cuid())
  nama     String     @unique
  warna    String     @default("#3498db")
  kegiatan Kegiatan[]
}

model Kegiatan {
  id             String        @id @default(cuid())
  judul          String
  jenis          JenisKegiatan @relation(fields: [jenisId], references: [id])
  jenisId        String
  deskripsi      String?
  tanggalMulai   DateTime
  tanggalSelesai DateTime?
  lokasi         String?
  berulang       Berulang      @default(TIDAK)
  catatanHasil   String?       @db.Text
  createdAt      DateTime      @default(now())
  createdBy      User          @relation("KegiatanDibuatOleh", fields: [createdById], references: [id])
  createdById    String
}

enum Berulang {
  TIDAK
  MINGGUAN
  BULANAN
}

// ==================== INVENTARIS ====================

model KategoriAset {
  id   String @id @default(cuid())
  nama String @unique
  aset Aset[]
}

model Aset {
  id                String       @id @default(cuid())
  kode              String       @unique
  nama              String
  kategori          KategoriAset @relation(fields: [kategoriId], references: [id])
  kategoriId        String
  jumlah            Int          @default(1)
  kondisi           KondisiAset  @default(BAIK)
  tanggalPerolehan  DateTime?
  nilaiPerolehan    Decimal?     @db.Decimal(12, 0)
  lokasiPenyimpanan String?
  keterangan        String?
  fotoUrl           String?
  createdAt         DateTime     @default(now())
}

enum KondisiAset {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
}

// ==================== KONFIGURASI ====================

model KonfigurasiSistem {
  id        String @id @default("singleton")
  kabupaten String?
  kecamatan String?
  desa      String?
  dusun     String?
  kodePos   String?
  rt        String?
  rw        String?
  ketuaRtId String?
  ketuaRwId String?
}